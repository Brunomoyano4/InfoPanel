<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- InfoPanel para Windows: ícono en la bandeja, LibreHardwareMonitor, audio de Windows, pantallas, ASUS y TDP.
       El servidor, la API y la web vienen de InfoPanel.Core -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Sin consola: corre con un ícono en la bandeja -->
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>InfoPanel</RootNamespace>
    <AssemblyName>InfoPanel</AssemblyName>
    <Description>Telemetría y control de PCs con Windows desde el celular</Description>
  </PropertyGroup>

  <!-- Publicación: un solo InfoPanel.exe autocontenido (no requiere instalar .NET) -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <!-- Sin archivos de IIS ni manifiesto de recursos estáticos: la web va embebida -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\InfoPanel.Core\InfoPanel.Core.csproj" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.Management" Version="10.0.14" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Evita choques de nombres entre WinForms y ASP.NET; se importan solo donde se usan -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <None Update="tools\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
